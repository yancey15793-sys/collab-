# Briefeed — variables d'environnement
# Copier en .env et remplir. Ne jamais committer .env.

# --- Base de données ---
# Option A (recommandé pour le dev, zéro install locale) : Neon / Supabase (Postgres gratuit hébergé)
# Option B : Postgres local (Homebrew) ou Docker
DATABASE_URL="postgresql://user:password@host:5432/briefeed"

# --- IA (Groq) ---
# La clé ne doit JAMAIS être exposée côté frontend. Utilisée uniquement par apps/api et apps/worker.
GROQ_API_KEY="gsk_xxx"
GROQ_MODEL="llama-3.3-70b-versatile"

# --- API ---
API_PORT=4000
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173"

# --- Worker / Ingestion ---
INGESTION_INTERVAL_MINUTES=15
INGESTION_CONCURRENCY=5
INGESTION_TIMEOUT_MS=10000

# --- Story Engine (seuils configurables, jamais en dur dans le code) ---
STORY_MATCH_THRESHOLD=0.62
STORY_CANDIDATE_WINDOW_HOURS=72
STORY_DORMANT_AFTER_HOURS=48
STORY_ARCHIVE_AFTER_DAYS=14

# --- Trend Engine (coefficients configurables) ---
TREND_WEIGHT_VELOCITY=0.25
TREND_WEIGHT_NOVELTY=0.20
TREND_WEIGHT_SOURCE_DIVERSITY=0.20
TREND_WEIGHT_ARTICLE_VOLUME=0.15
TREND_WEIGHT_CONFIRMATION=0.10
TREND_WEIGHT_FRESHNESS=0.10

# --- Environnement ---
NODE_ENV="development"
LOG_LEVEL="info"
