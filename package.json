{
  "name": "briefeed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Briefeed — Personal News Intelligence Engine",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @briefeed/db",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @briefeed/db",
    "db:studio": "dotenv -e .env -- npm run db:studio -w @briefeed/db",
    "dev:api": "dotenv -e .env -- npm run dev -w @briefeed/api",
    "dev:worker": "dotenv -e .env -- npm run dev -w @briefeed/worker",
    "dev:web": "npm run dev -w @briefeed/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
